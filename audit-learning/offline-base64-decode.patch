From 85476a654a716bac7124d7cafc1254d0ca5c1f2c Mon Sep 17 00:00:00 2001
From: Jems Integration Audit <jems-audit@users.noreply.github.com>
Date: Thu, 26 Nov 2026 06:36:14 +0000
Subject: [PATCH] Decode exact offline artwork without per-byte callback
 allocations

---
 tools/ui-review/shell.html | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tools/ui-review/shell.html b/tools/ui-review/shell.html
index 78c46e23..61021100 100644
--- a/tools/ui-review/shell.html
+++ b/tools/ui-review/shell.html
@@ -22,7 +22,13 @@
 /*__PAYLOAD__*/
 const $=id=>document.getElementById(id),manifest=PAYLOAD.manifest,frame=$('appFrame');
 const nativeURL=URL,cache=new Map(),assetKeys=Object.keys(PAYLOAD.assets).sort((a,b)=>b.length-a.length);
-const dec=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
+function dec(encoded) {
+  if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(encoded);
+  const binary = atob(encoded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+}
 function asset(key){if(!cache.has(key)){const [mime,b64]=PAYLOAD.assets[key];cache.set(key,URL.createObjectURL(new Blob([dec(b64)],{type:mime})));}return cache.get(key);}
 const resolve=value=>{for(const key of assetKeys)if(String(value).replace(/^\.\//,'').replace(/^\//,'')===key)return asset(key);return value;};
 const rewrite=text=>text.replace(/((?:src|href)\s*=\s*["'])([^"']+)(["'])/gi,(m,a,v,b)=>a+resolve(v)+b).replace(/url\(\s*(["']?)([^)"']+)\1\s*\)/g,(m,q,v)=>`url("${resolve(v)}")`);
