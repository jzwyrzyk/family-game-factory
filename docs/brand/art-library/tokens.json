  "policy": {
    "logo": "Load a locked supplied asset. Never typeset, trace, redraw, recolor or ask imagegen to recreate it.",
    "illustration": "Use approved raster art assets. Functional icons may use the supplied SVG set.",
    "text": "All interface text remains live HTML. No generated letters in banners or buttons.",
    "motion": "Respect prefers-reduced-motion; keep essential status readable without animation."
  },
