# Dedicated private inference only. No gateway, preview, GCP keys, public files,
# generated game runtimes or checked-in configuration in this image.
FROM node:22-bookworm-slim AS builder
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY server/coach ./server/coach
# Build-stage shared device-session verifier dependencies. Final image remains bundled-only.
COPY server/trusted-devices.ts ./server/trusted-devices.ts
# Shared trusted-device verifier now references the minimal, keyless parent choice policy.
COPY server/privacy/parent-consent.ts ./server/privacy/parent-consent.ts
COPY server/adult-pilot.ts ./server/adult-pilot.ts
# Explicit DEV policy remains inert without validated nonproduction identity.
COPY server/dev-access.ts server/dev-test-policy.ts ./server/
COPY server/pipeline/auth.ts ./server/pipeline/auth.ts
COPY src/studio/design.ts ./src/studio/design.ts
# Bundle typed provider + policy + validated private handler. The final image
# is a single immutable entrypoint, not the general application dependency tree.
RUN ./node_modules/.bin/esbuild server/coach/private-executor.ts \
    --bundle --platform=node --target=node22 --format=esm \
    --outfile=/source/private-executor.mjs --log-level=warning

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder --chown=node:node /source/private-executor.mjs /app/private-executor.mjs
USER node
EXPOSE 8080
CMD ["node", "/app/private-executor.mjs"]
