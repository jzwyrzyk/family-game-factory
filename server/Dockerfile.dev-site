# Build with the narrow context emitted by scripts/development/package-site.ts.
# It contains a bundled keyless server and verified static assets only.
FROM node:22-bookworm-slim
WORKDIR /app
COPY --chown=node:node dev-site.mjs /app/dev-site.mjs
COPY --chown=node:node site /app/site
ENV NODE_ENV=production JEMS_DEV_ASSETS=/app/site FACTORY_ENVIRONMENT=development
USER node
EXPOSE 8080
CMD ["node", "/app/dev-site.mjs"]
