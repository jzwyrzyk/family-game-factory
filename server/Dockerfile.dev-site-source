# The Cloud Build controller verifies the exact Git archive before and after
# building. Browser assets and server are built here, never trusted from a zip.
FROM node:22-bookworm-slim AS builder
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY index.html ./index.html
COPY src ./src
COPY public ./public
COPY server/dev-access.ts server/dev-site.ts ./server/
COPY tools/offline-build.ts ./tools/offline-build.ts
COPY tools/creative-game-art/raster.ts ./tools/creative-game-art/raster.ts
COPY tools/creative-art-review ./tools/creative-art-review
COPY server/sandbox/trusted/quality-runtime-v2.1.0/worker.js ./server/sandbox/trusted/quality-runtime-v2.1.0/worker.js
COPY scripts/development/build-site-image.ts ./scripts/development/build-site-image.ts
ARG REVIEWED_SOURCE_SHA
RUN JEMS_DEV_BUILD_SOURCE_SHA="$REVIEWED_SOURCE_SHA" node --import tsx scripts/development/build-site-image.ts

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=builder --chown=node:node /built/dev-site.mjs /app/dev-site.mjs
COPY --from=builder --chown=node:node /built/site /app/site
ENV NODE_ENV=production JEMS_DEV_ASSETS=/app/site FACTORY_ENVIRONMENT=development
USER node
EXPOSE 8080
CMD ["node", "/app/dev-site.mjs"]
