FROM node:22-bookworm-slim
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY --chown=node:node server ./server
# Gateway includes only keyless transport; private provider and private executor are removed.
RUN rm -f /app/server/coach/private-provider.ts /app/server/coach/private-executor.ts \
    /app/server/coach/private-speech-provider.ts /app/server/coach/cloud-token.ts
COPY --chown=node:node src/runtime/types.ts src/runtime/manifests.ts ./src/runtime/
# Pure request-identity serialization for authenticated lost-acknowledgement lookup.
COPY --chown=node:node src/builder/submission.ts ./src/builder/
COPY --chown=node:node src/storage/record-contract.ts src/storage/sync-contract.ts src/storage/cloud-recovery.ts src/storage/recovery-format.ts ./src/storage/
COPY --chown=node:node src/learning/grades.ts ./src/learning/
COPY --chown=node:node src/studio/design.ts ./src/studio/
# Shared coach validation imports only these pure readiness/display helpers.
COPY --chown=node:node src/studio/creation-readiness.ts src/studio/conversation-view.ts ./src/studio/
COPY --chown=node:node src/creation/model.ts src/creation/projects.ts ./src/creation/
# The scene allowlist resolves approved character/form IDs from pure metadata.
COPY --chown=node:node src/pals/catalog.ts src/pals/catalog-artwork.generated.ts src/pals/historical-scene-art.json ./src/pals/
ENV NODE_ENV=production
USER node
CMD ["node", "--import", "tsx", "server/gateway.ts"]
