          "401": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
