{
  "openapi": "3.1.0",
  "info": {
    "title": "Family Factory private build API",
    "version": "2.0.0",
    "description": "Authenticated family gateway and separate private preview; Actions worker stages use approved workflow OIDC. Paid activation requires owner setup."
  },
  "servers": [
    {
      "url": "https://family-api.example.invalid"
    }
  ],
  "security": [
    {
      "familySession": []
    }
  ],
  "paths": {
    "/v1/jobs": {
      "post": {
        "summary": "Validate, authorize, reserve quota and durably acknowledge an idempotent job",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuildRequest"
              }
            }
          }
        }
      }
    },
