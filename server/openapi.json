    "/v1/creations": {
      "get": {
        "summary": "List authenticated family kept games",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Creations"
                }
              }
            }
          },
          "400": {
            "description": "Unauthorized, forbidden, validation, unavailable or quota failure",
            "content": {
