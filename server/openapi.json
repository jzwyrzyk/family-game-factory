                }
              }
            }
          }
        }
      }
    },
    "/v1/revisions/{id}": {
      "get": {
        "summary": "Read private immutable revision metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[\\w-]{1,100}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          }
        }
      }
    },
    "/v1/revisions/{id}/fork": {
      "post": {
        "summary": "Save tested game as an independent private game, retaining source provenance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[\\w-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Independent revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevisionReference"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "familySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "factory_session",
        "description": "Server-issued signed HttpOnly Secure SameSite cookie from trusted family identity provisioning. Never a caller-selected family ID. POST additionally requires an allowed Origin and X-Factory-Request: 1."
      }
    },
    "schemas": {
      "BuildRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "baseRevisionId",
          "prompt",
          "clientRequestId"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "baseRevisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "clientRequestId": {
            "type": "string",
            "pattern": "^[\\w-]{1,100}$"
          },
          "retryOf": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "queued",
              "building",
              "testing",
              "ready",
              "failed",
              "cancelled"
            ]
          },
          "revisionId": {
            "type": "string"
          },
          "adapter": {
            "enum": [
              "local-rule",
              "mock",
              "codex-subscription",
              "metered-api"
            ]
          },
          "errorCode": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "errorCode"
        ],
        "properties": {
          "errorCode": {
            "type": "string"
          }
        }
      },
      "LocalRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "localRevisionId",
          "config"
        ],
        "properties": {
          "gameId": {
            "enum": [
              "gum",
              "buckets",
              "dragon"
            ]
          },
          "localRevisionId": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "RevisionReference": {
        "type": "object",
        "required": [
          "revisionId"
        ],
        "properties": {
          "revisionId": {
            "type": "string"
          }
        }
      },
      "Preview": {
        "type": "object",
        "required": [
          "url",
          "artifactId",
          "expiresAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Short-lived scoped preview capability on a distinct hostname. Never saved in localStorage."
          },
          "artifactId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false
      },
      "Creations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "projectId": {
              "type": "string"
            },
            "game": {
              "$ref": "#/components/schemas/StarGame"
            }
          }
        }
      },
      "StarGame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "seconds"
        ],
        "properties": {
          "kind": {
            "const": "star-catcher-v1"
          },
          "target": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "seconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "ForkRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      },
      "Revision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "game": {
            "$ref": "#/components/schemas/StarGame"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
