    "/v1/revisions/{id}": {
      "get": {
        "summary": "Read private immutable revision metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[\\w-]{1,100}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          }
        }
      }
    },
    "/v1/revisions/{id}/fork": {
      "post": {
        "summary": "Save tested game as an independent private game, retaining source provenance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[\\w-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Independent revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevisionReference"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Redeem owner-provisioned one-time invitation for a partitioned HttpOnly session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invitation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connected; signed HttpOnly Secure SameSite=None Partitioned cookie"
          },
          "403": {
            "description": "Invalid/expired/used invitation or Origin/CSRF mismatch"
          }
        }
      }
    },
    "/v1/jobs/{id}/retry": {
      "post": {
        "summary": "Retry an authorized failed job after reload without copying its prompt",
        "responses": {
          "202": {
            "description": "Idempotent bounded retry acknowledgement"
          }
        }
      }
    },
    "/v1/worker/jobs/{id}/claim": {
      "post": {
        "summary": "Private Actions stage claim",
        "security": [
          {
            "workerOIDC": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized job-scoped stage result"
          },
          "403": {
            "description": "Untrusted/stale/foreign/duplicate worker claim rejected"
          }
        }
      }
    },
    "/v1/worker/jobs/{id}/report": {
      "post": {
        "summary": "Private Actions stage report",
        "security": [
          {
            "workerOIDC": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized job-scoped stage result"
          },
          "403": {
            "description": "Untrusted/stale/foreign/duplicate worker claim rejected"
          }
        }
      }
    },
    "/v1/worker/jobs/{id}/status": {
      "get": {
        "summary": "Private Actions stage status",
        "security": [
          {
            "workerOIDC": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized job-scoped stage result"
          },
          "403": {
            "description": "Untrusted/stale/foreign/duplicate worker claim rejected"
          }
        }
      }
    },
    "/v1/internal/dispatch": {
      "post": {
        "summary": "Authenticated scheduler wakeup for durable retry and job expiry",
        "security": [
          {
            "schedulerOIDC": []
          }
        ],
        "responses": {
          "204": {
            "description": "Dispatcher tick complete"
          },
          "403": {
            "description": "Untrusted scheduler rejected"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "familySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "factory_session",
        "description": "Server-issued signed HttpOnly Secure SameSite cookie from trusted family identity provisioning. Never a caller-selected family ID. POST additionally requires an allowed Origin and X-Factory-Request: 1."
      },
      "workerOIDC": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "GitHub Actions OIDC JWT",
        "description": "Exact repository ID, reviewed tag/SHA, workflow, environment, audience, issuer and first run attempt. Stage/run/job binding enforced."
      },
      "schedulerOIDC": {
        "type": "http",
        "scheme": "bearer",
        "description": "Google signed OIDC; exact scheduler account email, verified email and gateway audience."
      }
    },
    "schemas": {
      "BuildRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "baseRevisionId",
          "prompt",
          "clientRequestId"
        ],
        "properties": {
          "gameId": {
            "enum": [
              "new",
              "gum",
              "buckets",
              "dragon",
              "star-catcher",
              "generated-module"
            ]
          },
          "baseRevisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "clientRequestId": {
            "type": "string",
            "pattern": "^[\\w-]{1,100}$"
          },
          "retryOf": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "queued",
              "building",
              "testing",
              "ready",
              "failed",
              "cancelled"
            ]
          },
          "revisionId": {
            "type": "string"
          },
          "adapter": {
            "enum": [
              "local-rule",
              "mock",
              "codex-subscription",
              "metered-api"
            ]
          },
          "errorCode": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "generating",
              "testing",
              "repairing",
              "ready",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "errorCode"
        ],
        "properties": {
          "errorCode": {
            "type": "string"
          }
        }
      },
      "LocalRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "localRevisionId",
          "config"
        ],
        "properties": {
          "gameId": {
            "enum": [
              "gum",
              "buckets",
              "dragon"
            ]
          },
          "localRevisionId": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "RevisionReference": {
        "type": "object",
        "required": [
          "revisionId"
        ],
        "properties": {
          "revisionId": {
            "type": "string"
          }
        }
      },
      "Preview": {
        "type": "object",
        "required": [
          "url",
          "artifactId",
          "expiresAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Short-lived scoped preview capability on a distinct hostname. Never saved in localStorage."
          },
          "artifactId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false
      },
      "Creations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "projectId": {
              "type": "string"
            },
            "game": {
              "oneOf": [
                {"$ref": "#/components/schemas/StarGame"},
                {"$ref": "#/components/schemas/GeneratedMetadata"}
              ]
            }
          }
        }
      },
      "StarGame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "seconds"
        ],
        "properties": {
          "kind": {
            "const": "star-catcher-v1"
          },
          "target": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "seconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "ForkRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      },
      "Revision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "game": {
            "oneOf": [
              {"$ref": "#/components/schemas/StarGame"},
              {"$ref": "#/components/schemas/GeneratedMetadata"}
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GeneratedMetadata": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["generated-module-v1", "generated-module-v2"]
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invitation"
        ],
        "properties": {
          "invitation": {
            "type": "string",
            "minLength": 40,
            "maxLength": 100
          }
        }
      }
    }
  }
}
