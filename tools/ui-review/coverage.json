  "journeys": [
    "Welcome → character → creation conversation → build → wait → play → keep",
    "Ready-to-play native game → local edit → compare → keep / undo",
    "Creative Studio → scene → blocks → run → save → reopen",
    "Coding challenge → inspect target → rebuild → check / retry",
    "Art Studio → draw / upload → prepare → save → reuse",
    "My Powers → Math / English → answer → hint / retry → next",
    "Parent → learner → progress → evidence → school → settings / export",
    "Gem Pals → choose / inspect → growth → create with Pal",
    "Rewards → gems → achievements → maker journey",
    "Notifications → build status → open saved creation",
    "Trusted devices → invitation → guardian choices → private adult session",
    "My Games → My Journey → My Pals / Gems & achievements / My Powers → practice",
    "Creative Studio → first-visit movement → skip / finish → Make / Rebuild / experiment",
    "Ready saved conversation → unsent correction → explicit Build → updated review → explicit Build"
